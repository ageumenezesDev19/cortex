# Copy to .env and fill in. The .env itself is gitignored and never read by
# anything but the app.
#
# Both are optional and the app works without either — the answer button just
# explains what is missing. Groq is tried first; Gemini takes over when Groq
# rate-limits.
#
# An app opened from the Finder inherits no shell environment, so for the
# installed .app put the same lines in ~/Cortex/.server/env instead.

GROQ_API_KEY=
GEMINI_API_KEY=
