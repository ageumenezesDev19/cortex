# The web demo's build output. Its input, demo/data-*.json, is committed on
# purpose: those vectors come from the Rust example and the deploy host has
# no cargo to regenerate them with.
dist-demo
.vercel

# The knowledge graph an agent builds of this repo. Derived, and about the code
# rather than part of it.
graphify-out

# Compiled from ocr/main.swift by scripts/build-ocr.sh
src-tauri/binaries

# API keys for the answer feature. Listed before any key exists, so the first
# `git add -A` after one is written cannot pick it up.
.env
.env.*
!.env.example

